<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="defs_kotlin"
                  targetNamespace="http://example.net/bpmn">
  <bpmn:process id="kotlinProcess" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="order" name="Order"
                      camunda:delegateExpression="${kotlinOrderDelegate}"/>
    <bpmn:serviceTask id="ship" name="Ship"
                      camunda:class="net.example.delegate.KotlinShippingDelegate"/>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="order"/>
    <bpmn:sequenceFlow id="f2" sourceRef="order" targetRef="ship"/>
    <bpmn:sequenceFlow id="f3" sourceRef="ship" targetRef="end"/>
  </bpmn:process>
</bpmn:definitions>
